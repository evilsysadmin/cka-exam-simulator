{
  "name": "cka-exam-simulator-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:public": "tsc --noEmit && vite build --config vite.public.config.ts && node scripts/prepare-public.mjs",
    "test:public": "node --test tests/public-preview.test.mjs",
    "build:account-staging": "tsc --noEmit && vite build --config vite.account.config.ts && node scripts/prepare-public.mjs account-staging",
    "test:account": "node --experimental-strip-types --test --test-isolation=none tests/identitySession.test.ts",
    "test:account-browser": "node tests/account-browser.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.0",
    "playwright": "1.64.1"
  }
}
